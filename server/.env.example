# Server Port
PORT=5000

# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gardenme?schema=public"

# JWT Secret for User Auth
JWT_SECRET="gardenme_jwt_secret_change_in_production"

# Web Push VAPID Keys for PWA Push Notifications
# Generate new pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="B..."
VAPID_PRIVATE_KEY="..."
VAPID_SUBJECT="mailto:admin@gardenme.app"
