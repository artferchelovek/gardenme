// Prisma Schema for GardenMe Backend

generator client {
  provider = "prisma-client-js"
}

generator frontendClient {
  provider = "prisma-client-js"
  output   = "../../src/types/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  passwordHash      String
  name              String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  plants            Plant[]
  devices           Device[]
  pushSubscriptions PushSubscription[]

  @@map("users")
}

model Device {
  id               String            @id @default(uuid())
  token            String            @unique @default(uuid())
  name             String
  macAddress       String?
  lastBatteryLevel Float?
  lastSeenAt       DateTime?
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  plant            Plant?
  readings         MoistureReading[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@map("devices")
}

model Plant {
  id                   String            @id @default(uuid())
  name                 String
  species              String?
  location             String?
  minMoistureThreshold Float             @default(30.0)
  targetMoistureLevel  Float             @default(70.0)
  userId               String
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId             String?           @unique
  device               Device?           @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  readings             MoistureReading[]
  waterings            WateringLog[]
  notifications        NotificationLog[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@map("plants")
}

model MoistureReading {
  id        String   @id @default(uuid())
  moisture  Float
  battery   Float
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  plantId   String?
  plant     Plant?   @relation(fields: [plantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([plantId, createdAt])
  @@index([deviceId, createdAt])
  @@map("moisture_readings")
}

model WateringLog {
  id                    String   @id @default(uuid())
  plantId               String
  plant                 Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  moistureBefore        Float?
  moistureAfter         Float?
  detectedAutomatically Boolean  @default(false)
  note                  String?
  createdAt             DateTime @default(now())

  @@index([plantId, createdAt])
  @@map("watering_logs")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@map("push_subscriptions")
}

model NotificationLog {
  id      String   @id @default(uuid())
  plantId String
  plant   Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  type    String
  sentAt  DateTime @default(now())

  @@index([plantId, type, sentAt])
  @@map("notification_logs")
}
